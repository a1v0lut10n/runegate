RUNEGATE_ENV={{ runegate_env | default('production') }}
RUNEGATE_MODE={{ runegate_mode | default('gateway') }}
RUNEGATE_AUTH_UI_MODE={{ runegate_auth_ui_mode | default('static') }}

# Server Bind Address
RUNEGATE_HOST=127.0.0.1
RUNEGATE_PORT=7870

# Proxied Target
RUNEGATE_TARGET={{ runegate_target | default('http://127.0.0.1:8000') }}

# Secrets (From Vault)
RUNEGATE_JWT_SECRET={{ vault_jwt_secret }}
RUNEGATE_SESSION_KEY={{ vault_session_key }}
RUNEGATE_ADMIN_API_TOKEN={{ vault_admin_api_token | default('') }}

# Databases
DATABASE_URL={{ vault_database_url | default('') }}
REDIS_URL={{ vault_redis_url | default('redis://127.0.0.1:6379') }}

# SMTP Settings
SMTP_SERVER={{ smtp_server | default('') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ vault_smtp_password | default('') }}

# OIDC
RUNEGATE_GOOGLE_CLIENT_ID={{ google_client_id | default('') }}
RUNEGATE_GOOGLE_CLIENT_SECRET={{ vault_google_client_secret | default('') }}
RUNEGATE_GOOGLE_REDIRECT_URL={{ google_redirect_url | default('') }}
